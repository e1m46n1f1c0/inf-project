#-------------------------------------------------------------------------------
# APPS
#-------------------------------------------------------------------------------
#
# Ajustes personalizados para cada aplicación

#-------------------------------- APPS -----------------------------------------
#-------------------------------- PAYMENTS -------------------------------------
# Nombre de la App creada en el proveedor de pagos
PAYMENTS_APP_NAME=development
# Proveedor de pagos
PAYMENTS_APP_PROVIDER=payment
# URL de la API de pagos
PAYMENTS_API_URL=http://localhost:8000/api/v1/payments
# ID del cliente Generado en el cliente de pagos
PAYMENTS_CLIENT_ID=client_id
# Clave secreta del cliente Generado en el cliente de pagos
PAYMENTS_CLIENT_SECRET=client_secret
# URL de redirección en caso de éxito
PAYMENTS_SUCCESS_URL=subscriptions/$parameter/success
# URL de redirección en caso de cancelación en la compra de un plan
PAYMENTS_CANCEL_URL=$parameter/plans
# URL de redirección en caso de cancelación en la edición de un plan
PAYMENTS_CANCEL_EDIT_URL=$parameter/my-subscription
# Nombre de los parámetros de redirección
PAYMENTS_SUCCESS_PARAMETER_URL='$parameter'
PAYMENTS_CANCEL_PARAMETER_URL='$parameter'
# URL de redirección en caso de webhook
PAYMENTS_WEBHOOK_URL=$param/subscriptions/webhook
# Modo de pagos
PAYMENTS_MODE=sandbox
# Moneda de pagos
PAYMENTS_CURRENCY=USD
# Resources
PAYMENTS_RESOURCES="
    tickets.model= #NameSpace\\Of\\Payment\\OrdersModelResourceModel
"

#-------------------------------- SUBSCRIPTIONS ---------------------------------
SUBSCRIPTIONS_FREE_TIME="1 month"

SUBSCRIPTIONS_EXTRA_TIME_TO_PAY="4 days"

