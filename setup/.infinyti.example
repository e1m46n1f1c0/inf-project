# BOOT
#-------------------------------------------------------------------------------
#
INFINYTI_KEY="4a7490c2-7004-4e8a-ab85-c877092c1484"

#CRON_KEY="cron-019a2c8d-fed5-77dc-a938-3d616e2b61ad"

APP_DOCS_URL=https://docs.ideasfarm.net

APP_BASE_URL=#https://domain.com
# Define el entorno de ejecución del sistema dev: desarrollo, prod: producción
APP_ENV=dev

# Define la configuración de la aplicación, si esta en true, se cacheará la
# configuración para mejorar el rendimiento, pero se requerirá reiniciar la
# aplicación para que los cambios en la configuración tengan efecto. En
# desarrollo, se recomienda dejarlo en false para facilitar el desarrollo.
APP_CONFIG_CACHE=false
APP_PROFILE=true

# Define el directorio de trabajo
APP_WORKSPACES=front,admin,cli

# Define si se debe forzar el uso de https
APP_FORCE_HTTPS=true

# Define si debe ejecutar la comprobación de permisos del rol del usuario
APP_PERMMISIONS=false

# Define el protocolo de la aplicación (https o http) por defecto si no se
# define en el host
APP_PROTOCOL=

# Define el nombre de la aplicación de control de accesos
ACL_APP=acl

# Define si se debe tokenizar los formularios
TOKENIZING_FORMS=false

# Define si se debe tokenizar las URLs
TOKENIZING_URLS=false

# Define el nombre de la aplicación
APP_TITLE=Infinyti

# Define el idioma de la aplicación
APP_LANG=en-US

# Define la zona horaria de la aplicación
APP_TIMEZONE=America/Guayaquil

# Determina el sistema de base de datos activo
TEMPLATE=html

# Define el skin de la aplicación para frontend
FRONT_SKIN=infinyti

# Define el skin de la aplicación para administrador
ADMIN_SKIN=pulsar

# Define la clave encriptación
SECRET=

# Define el IV
IV=

# Define los países objetivo de la aplicación, usando códigos ISO 3166-1 alpha-2,
# separados por comas. Usar 'ALL' indica operación internacional.
# Codes: https://es.wikipedia.org/wiki/ISO_3166-1_alpha-2
TARGET_COUNTRIES=ALL

#------------------------------------ BOOT -------------------------------------
#----------------------- CONFIGURACION DEL PROYECTO FRONTEND--------------------

APP_FRONTEND=

#------------------------------------ BOOT -------------------------------------
#-------------------------------- - SESSIONS -----------------------------------

# Define cómo se controla el caché en las páginas de sesión. Valores posibles:
# nocache, public, private, private_no_expire,
# o una cadena vacía para deshabilitar el caché.
SESSION_CACHE_LIMITER=nocache

# Tiempo de vida de la cookie de sesión en segundos. 24 horas
SESSION_COOKIE_LIFETIME=86400

# Tiempo máximo en segundos para que los datos de sesión sean almacenados.
# 24 horas
SESSION_GC_MAXLIFETIME=86400

# Tiempo en segundos que debe pasar sin actividad para que la sesión sea
# invalidada. 24 horas
SESSION_INACTIVE_LIMIT=86400

# Define si las cookies deben enviarse solo a través de conexiones seguras
# (HTTPS). Valores posibles: true, false, o 'auto' para enviar solo en
# conexiones seguras.
SESSION_COOKIE_SECURE=true

# Controla el envío de cookies junto con solicitudes entre sitios. Valores
# posibles: None, Lax, Strict, o una cadena vacía para deshabilitar el control.
SESSION_COOKIE_SAMESITE=lax

# Si está activado (true), la cookie solo será accesible a través del protocolo
# HTTP, lo que aumenta la seguridad al prevenir el acceso a través de scripts
# como JavaScript.
SESSION_COOKIE_HTTPONLY=true

# Cuando está activado (true), impide el uso de identificadores de sesión no
# inicializados, lo que puede ayudar a prevenir ciertos ataques de secuestro
# de sesión.
SESSION_USE_STRICT_MODE=true

# Duración de la función "recordarme", en segundos.  1 semana
SESSION_REMEMBER_ME_LIFETIME=604800

# Path para la cookie para la sesión, debe ser un path absoluto
SESSION_COOKIE_PATH="/"

# Dominio para la cookie, null para el dominio actual
SESSION_COOKIE_DOMAIN=

# Si las cookies deben enviarse sin codificar url
SESSION_COOKIE_RAW=false

