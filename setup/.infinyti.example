#-------------------------------------------------------------------------------
# APPLICATIONS
#-------------------------------------------------------------------------------
# ACL
#-------------------------------------------------------------------------------
#

# Establece si el sistma de control de acceso permite OAuth2
ACL_OAUTH2=false
# Establece el tipo de registro de usuarios
# ACL_REGISTER_TYPE=default
# Establece los campos por los que se identifica usuarios en FRONT
ACL_USER_NAME_FIELD_FRONT=username,email
# Permite que username sea igual al email cuando registra un usuario
# ACL_USERNAME_EQUALS_EMAIL=false
# Permitir registro sin contraseña
# ACL_REGISTER_WITHOUT_PASSWORD=false
# Establece los campos por los que se identifica usuarios en ADMIN
ACL_USER_NAME_FIELD_ADMIN=username
# Permite iniciar sessión a usuarios que aun no activan la cuenta
ACL_ALLOW_NO_ENABLED_USERS=true
# Determina el tiempo en dias que pasara antes de el sistema solicite al
# usuario activar su cuenta
# TODO: Nueva caracteristica
ACL_DAYS_TO_ENABLE_ACCOUNT=
# Inica la URL de cancelación, si esta activo OAuth2
ACL_CANCEl_URL=
# Estable los dias que deben pasar para mostrar una alerta de cambio de
# contraseña
ACL_DAYS_CHANGE_PASSWORD=45
# Url de redirección para el servidor de OAuth2 por defecto
ACL_DEFAULT_SERVER_REDIRECT=

#-------------------------------------------------------------------------------
# ACL- Members
#-------------------------------------------------------------------------------
#
# Estable una lista de recursos a los que un usuario puede ser miembro
#
ACL_MEMBERS_RESOURCES= #"resource-name1=NameSpace/Of/Resource1,resource-name2=NameSpace/Of/Resource2"
ACL_MEMBERS_RESOURCES_MODELS= #"resource-name1=NameSpace/Of/Model/Resource1,resource-name2=NameSpace/Of/Model/Resource2"
ACL_MEMBERS_INVITE_URL=

