# =============================================================
# CONFIGURACIÓN DEL ORQUESTADOR — Infinyti Framework
# Copia este archivo a .env y ajusta los valores del proyecto.
# =============================================================

# Nombre base del proyecto Docker
COMPOSE_PROJECT_NAME=ideasfarm

# Dominio base del cliente
CLIENT_DOMAIN=ideasfarm.local

# Entorno de esta instancia (prod | dev | alpha | beta)
APP_ENV=prod

# Identificación del servicio para Traefik
SERVICE_NAME=acl-server
SERVICE_SUBDOMAIN=login

# Tipo de repositorio
# ONE_REPO   → proyecto monolítico (ej. website)
# MULTI_REPO → proyecto modular con apps y templates en src/
REPO_TYPE=MULTI_REPO

# Montar código local en el contenedor
MOUNT_CODE=true

# Script de instalación específico (ej: install.sh o infinyti-install.sh)
# Dejar vacío si no se requiere ninguna instalación post-despliegue.
INSTALL_SCRIPT=

CERT_RESOLVER=local-acme
